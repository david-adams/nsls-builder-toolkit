{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" session-start",
            "timeout": 90,
            "statusMessage": "Syncing builder toolkit...",
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" policy",
            "timeout": 15,
            "statusMessage": "Loading builder guardrails…",
            "shell": "bash"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-event.sh\"",
            "timeout": 5,
            "statusMessage": "Logging skill use so you get NSLS credit (nothing else)\u2026",
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "^(Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" gate",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking builder guardrails\u2026"
          }
        ]
      }
    ]
  }
}
